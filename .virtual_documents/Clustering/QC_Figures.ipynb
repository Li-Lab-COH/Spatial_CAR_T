import scanpy as sc
import pandas as pd
import matplotlib.pyplot as plt
from matplotlib.ticker import PercentFormatter

# --- 0) Ensure mt% exists (compute once) ---
# Flag mt genes
if 'gene_symbols' in ST_sample.var.columns:
    ST_sample.var['mt'] = ST_sample.var['gene_symbols'].str.upper().str.startswith('MT-')
else:
    ST_sample.var['mt'] = ST_sample.var_names.str.upper().str.startswith('MT-')

# Calculate QC metrics -> adds pct_counts_mt (0–100) to .obs
if 'pct_counts_mt' not in ST_sample.obs.columns:
    sc.pp.calculate_qc_metrics(ST_sample, qc_vars=['mt'], percent_top=None, log1p=False, inplace=True)

# Fraction 0–1 for plotting
ST_sample.obs['mt_frac'] = ST_sample.obs['pct_counts_mt'] / 100.0

# --- 1) Prepare ordering helpers ---
obs = ST_sample.obs
if pd.api.types.is_categorical_dtype(obs['mouse']):
    global_mouse_order = list(obs['mouse'].cat.categories)
else:
    global_mouse_order = sorted(obs['mouse'].unique())

# --- 2) One figure per TMA ---
for tma in obs['TMA'].unique():
    sub = obs.loc[obs['TMA'] == tma, ['mouse', 'mt_frac']].copy()
    if sub.empty:
        continue

    # Mean mt% per mouse in this TMA
    mean_mt = sub.groupby('mouse')['mt_frac'].mean()

    # Keep a consistent mouse order, but only those present in this TMA
    ordered_mice = [m for m in global_mouse_order if m in mean_mt.index]
    mean_mt = mean_mt.reindex(ordered_mice)

    # Plot
    fig, ax = plt.subplots(figsize=(8, 6))
    ax.bar(mean_mt.index.astype(str), mean_mt.values)
    ax.set_xlabel('Mouse')
    ax.set_ylabel('Mean % mt genes')
    ax.set_title(f'Mean mitochondrial % per mouse — TMA: {tma}')
    ax.yaxis.set_major_formatter(PercentFormatter(xmax=1.0))
    ax.tick_params(axis='x', rotation=90)

    plt.tight_layout()
    plt.show()

    # OPTIONAL: save
    # fig.savefig(f"mean_mt_per_mouse_TMA_{tma}.png", dpi=300, bbox_inches='tight')




