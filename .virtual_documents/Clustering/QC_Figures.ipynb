import matplotlib.pyplot as plt
from matplotlib.ticker import FuncFormatter
import pandas as pd

# --- formatter for millions ---
def millions(x, pos):
    return f'{x*1e-6:.1f}M'

# pull the obs as a DataFrame
obs = ST_sample.obs

# sanity checks
required_cols = {'TMA', 'mouse', 'total_counts'}
missing = required_cols - set(obs.columns)
if missing:
    raise ValueError(f"Missing required columns in ST_sample.obs: {missing}")

# optional: preserve category order if mouse is categorical, else alphabetical
if pd.api.types.is_categorical_dtype(obs['mouse']):
    mouse_order_all = list(obs['mouse'].cat.categories)
else:
    mouse_order_all = sorted(obs['mouse'].unique())

# loop over TMA groups and plot one figure per TMA
for tma in obs['TMA'].unique():
    sub = obs.loc[obs['TMA'] == tma, ['mouse', 'total_counts']].copy()

    # aggregate total reads per mouse within this TMA
    total_reads_per_mouse = (
        sub.groupby('mouse')['total_counts']
        .sum()
        .reindex([m for m in mouse_order_all if m in sub['mouse'].unique()])  # keep consistent order
        .dropna()
    )

    if total_reads_per_mouse.empty:
        continue  # nothing to plot for this TMA

    # plot
    fig, ax = plt.subplots(figsize=(8, 6))
    ax.bar(total_reads_per_mouse.index.astype(str), total_reads_per_mouse.values)
    ax.set_title(f"Total Reads per Mouse — TMA: {tma}")
    ax.set_xlabel("Mouse")
    ax.set_ylabel("Total Reads")
    ax.tick_params(axis='x', rotation=90)
    ax.yaxis.set_major_formatter(FuncFormatter(millions))

    plt.tight_layout()
    plt.show()

    # OPTIONAL: save each figure
    # fig.savefig(f"total_reads_per_mouse_TMA_{tma}.png", dpi=300, bbox_inches='tight')



