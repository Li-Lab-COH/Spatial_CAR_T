import matplotlib.pyplot as plt
import pandas as pd

obs = ST_sample.obs

# Optional: a global order to use when a mouse appears in this TMA
if pd.api.types.is_categorical_dtype(obs['mouse']):
    global_order = list(obs['mouse'].cat.categories)
else:
    global_order = sorted(obs['mouse'].unique())

for tma in obs['TMA'].unique():
    sub = obs.loc[obs['TMA'] == tma, ['mouse', 'total_counts']].copy()
    if sub.empty:
        continue

    # Drop mice not present in this TMA (the key step)
    if pd.api.types.is_categorical_dtype(sub['mouse']):
        sub['mouse'] = sub['mouse'].cat.remove_unused_categories()
        # keep global order but only for mice in this TMA
        order_here = [m for m in global_order if m in list(sub['mouse'].cat.categories)]
        sub['mouse'] = sub['mouse'].cat.reorder_categories(order_here, ordered=True)
    else:
        # or just use alphabetical within this TMA
        order_here = sorted(sub['mouse'].unique())
        sub['mouse'] = pd.Categorical(sub['mouse'], categories=order_here, ordered=True)

    # Aggregate (observed=True prevents pandas from re‑adding dropped categories)
    mean_umis   = sub.groupby('mouse', observed=True)['total_counts'].mean()
    median_umis = sub.groupby('mouse', observed=True)['total_counts'].median()

    # Plot one figure per TMA
    fig, axes = plt.subplots(1, 2, figsize=(12, 5), sharey=True)

    axes[0].bar(mean_umis.index.astype(str), mean_umis.values)
    axes[0].set_title(f'Mean UMIs per Mouse — TMA: {tma}')
    axes[0].set_xlabel('Mouse')
    axes[0].set_ylabel('UMIs')
    axes[0].tick_params(axis='x', rotation=90)

    axes[1].bar(median_umis.index.astype(str), median_umis.values)
    axes[1].set_title(f'Median UMIs per Mouse — TMA: {tma}')
    axes[1].set_xlabel('Mouse')
    axes[1].tick_params(axis='x', rotation=90)

    plt.tight_layout()
    plt.show()



import matplotlib.pyplot as plt
from matplotlib.ticker import PercentFormatter
import pandas as pd

THRESH = 100  # change if you want a different cutoff

obs = ST_sample.obs

# Optional global order (used only to order mice that actually appear in each TMA)
if pd.api.types.is_categorical_dtype(obs['mouse']):
    global_order = list(obs['mouse'].cat.categories)
else:
    global_order = sorted(obs['mouse'].unique())

for tma in obs['TMA'].unique():
    sub = obs.loc[obs['TMA'] == tma, ['mouse', 'total_counts']].copy()
    if sub.empty:
        continue

    # Keep only mice present in this TMA (drop unused categories)
    if pd.api.types.is_categorical_dtype(sub['mouse']):
        sub['mouse'] = sub['mouse'].cat.remove_unused_categories()
        order_here = [m for m in global_order if m in list(sub['mouse'].cat.categories)]
        sub['mouse'] = sub['mouse'].cat.reorder_categories(order_here, ordered=True)
    else:
        order_here = sorted(sub['mouse'].unique())
        sub['mouse'] = pd.Categorical(sub['mouse'], categories=order_here, ordered=True)

    # Totals per mouse (only mice in this TMA)
    total_n = sub.groupby('mouse', observed=True).size().reindex(order_here)

    # Counts below and above/equal threshold per mouse
    low_n  = sub.loc[sub['total_counts'] <  THRESH].groupby('mouse', observed=True).size().reindex(order_here).fillna(0)
    high_n = sub.loc[sub['total_counts'] >= THRESH].groupby('mouse', observed=True).size().reindex(order_here).fillna(0)

    # Fractions
    frac_low  = (low_n  / total_n).fillna(0)
    frac_high = (high_n / total_n).fillna(0)

    # Plot two side‑by‑side bar charts for this TMA
    fig, axes = plt.subplots(1, 2, figsize=(12, 5), sharey=True)

    axes[0].bar(frac_low.index.astype(str), frac_low.values)
    axes[0].set_title(f'Fraction < {THRESH} UMIs — TMA: {tma}')
    axes[0].set_xlabel('Mouse')
    axes[0].set_ylabel('Fraction of cells')
    axes[0].tick_params(axis='x', rotation=90)
    axes[0].yaxis.set_major_formatter(PercentFormatter(xmax=1.0))

    axes[1].bar(frac_high.index.astype(str), frac_high.values)
    axes[1].set_title(f'Fraction ≥ {THRESH} UMIs — TMA: {tma}')
    axes[1].set_xlabel('Mouse')
    axes[1].tick_params(axis='x', rotation=90)
    axes[1].yaxis.set_major_formatter(PercentFormatter(xmax=1.0))

    plt.tight_layout()
    plt.show()

    # OPTIONAL: save
    # fig.savefig(f"fraction_under_over_{THRESH}_UMI_TMA_{tma}.png", dpi=300, bbox_inches='tight')

